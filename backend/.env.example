# Bax backend environment
DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Subscription pricing (Namibian Dollar)
SUBSCRIPTION_PRICE_CENTS=20000
SUBSCRIPTION_CURRENCY="NAD"

# PayToday payment provider
# Leave PAYTODAY_MODE=sandbox to use the built-in mock gateway.
# Set PAYTODAY_MODE=live and provide credentials to use the real PayToday API.
PAYTODAY_MODE="sandbox"
PAYTODAY_API_BASE="https://api.paytoday.com.na"
PAYTODAY_MERCHANT_ID=""
PAYTODAY_API_KEY=""
PAYTODAY_WEBHOOK_SECRET="sandbox-webhook-secret"

# Default admin seeded into the database
ADMIN_EMAIL="admin@bax.tv"
ADMIN_PASSWORD="Admin123!"

# CORS allowed origins (comma separated). Use * for dev.
CORS_ORIGINS="*"
