# Opportunities Namibia backend environment
DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# Membership pricing (Namibian Dollar) - N$200 every 6 months
MEMBERSHIP_PRICE_CENTS=20000
MEMBERSHIP_CURRENCY="NAD"
MEMBERSHIP_PERIOD_MONTHS=6

# Manual mobile payment: members pay this number, an admin then confirms access.
PAYMENT_PHONE="+264814680324"
PAYMENT_ACCOUNT_NAME="Opportunities Namibia"

# Automatic vacancy ingestion from configured online sources
INGESTION_ENABLED="true"
INGESTION_INTERVAL_MINUTES=360

# Default admin seeded into the database
ADMIN_EMAIL="admin@opportunities.na"
ADMIN_PASSWORD="Admin123!"

# CORS allowed origins (comma separated). Use * for dev.
CORS_ORIGINS="*"
