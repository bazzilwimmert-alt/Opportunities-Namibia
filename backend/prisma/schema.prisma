// Opportunities Namibia - jobs board data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String
  fullName        String
  phone           String?
  role            String   @default("USER") // USER | ADMIN
  termsAcceptedAt DateTime?
  status          String   @default("ACTIVE") // ACTIVE | SUSPENDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  profiles     Profile[]
  membership   Membership?
  payments     PaymentClaim[]
}

// Each account can have up to 2 profiles.
model Profile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  avatar    String?
  headline  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// 6-month paid access to vacancies. Activated by an admin after confirming a
// manual mobile payment; auto-expires at period end.
model Membership {
  id               String    @id @default(cuid())
  userId           String    @unique
  // INACTIVE = never paid, PENDING = payment submitted, awaiting admin confirm,
  // ACTIVE = access granted, EXPIRED = period elapsed
  status           String    @default("INACTIVE")
  priceCents       Int       @default(20000) // N$200.00
  currency         String    @default("NAD")
  periodMonths     Int       @default(6)
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A user-submitted record that they paid the admin's mobile number. The admin
// reviews and confirms it, which grants 6 months of access.
model PaymentClaim {
  id           String    @id @default(cuid())
  userId       String
  amountCents  Int       @default(20000)
  currency     String    @default("NAD")
  reference    String?   // payer reference / note the user provides
  payerPhone   String?   // number the user paid from
  status       String    @default("PENDING") // PENDING | CONFIRMED | REJECTED
  reviewedAt   DateTime?
  reviewedById String?
  periodStart  DateTime?
  periodEnd    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id          String    @id @default(cuid())
  title       String
  company     String
  location    String    @default("Namibia")
  category    String    @default("General") // IT, Construction, Healthcare, ...
  type        String    @default("FULL_TIME") // FULL_TIME|PART_TIME|CONTRACT|TEMPORARY|INTERNSHIP
  skillLevel  String    @default("SKILLED") // SKILLED | UNSKILLED
  description String
  salary      String?
  applyUrl    String?
  applyEmail  String?
  contact     String?
  source      String    @default("MANUAL") // MANUAL | RSS | LINKEDIN
  externalId  String?   @unique // dedupe key for ingested jobs
  postedAt    DateTime  @default(now())
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// Configurable online sources the ingestion job pulls vacancies from.
model JobSource {
  id            String    @id @default(cuid())
  name          String
  type          String    @default("RSS") // RSS | LINKEDIN
  url           String
  category      String?   // default category to tag ingested jobs
  enabled       Boolean   @default(true)
  lastFetchedAt DateTime?
  lastResult    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Editable platform-wide settings the admin controls online.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
